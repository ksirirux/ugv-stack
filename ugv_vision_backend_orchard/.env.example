# Frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5177,http://127.0.0.1:5177

# XYZ raster tile template. It must contain {x}, {y}, and {z}.
# Configure a provider whose terms permit server-side retrieval and analysis.
MAP_TILE_URL=https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}

MAP_TILE_USER_AGENT=UGV-FieldPlanner/1.0
MAX_TILE_COUNT=64
TILE_REQUEST_TIMEOUT_SEC=12
MIN_ROW_SPACING_M=0.8
MAX_ROW_SPACING_M=12.0

# Orchard/tree detection tuning
MIN_TREE_CROWN_RADIUS_M=0.7
MAX_TREE_CROWN_RADIUS_M=6.0
MIN_TREE_CENTER_GAP_M=2.0
MAX_DETECTED_TREES=1500
MAX_TREE_NEIGHBOR_DISTANCE_M=25.0
TREE_GRID_ANGLE_TOLERANCE_DEG=18.0
MIN_ORCHARD_SPACING_M=2.0
MAX_ORCHARD_SPACING_M=20.0
